# Backend (optional; defaults work for local run)
# ASPNETCORE_URLS=http://localhost:5000
# ConnectionStrings__Default=Data Source=incidentbrain.db

# Frontend: API base URL (for browser requests)
# When running with docker-compose, use http://localhost:8080 so the browser can reach the API.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Keyed ingest from DJ Visualizer. Empty disables POST /api/ingest/logs (returns 503).
# Generate a long random string and set the same value on DJ as Ops__IngestKey.
# Ingest__ApiKey=
