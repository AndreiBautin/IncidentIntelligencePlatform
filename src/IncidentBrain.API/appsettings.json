{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=incidentbrain.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5000", "http://127.0.0.1:3000", "http://127.0.0.1:5000" ]
  },
  "RateLimit": {
    "GeneralPerSecond": 100,
    "MutationPerMinute": 30
  },
  "Analysis": {
    "ClusterSimilarityThreshold": 0.5,
    "ClusterSizeThreshold": 10,
    "SpikeBaselineMultiplier": 3,
    "SpikeP1Threshold": 6,
    "SpikeP2Threshold": 3,
    "SpikeP3Threshold": 2,
    "MaxLogsPerBatch": 500,
    "MaxSummaryLength": 500,
    "ReanalysisCooldownSeconds": 60
  },
  "AI": {
    "Provider": "Mock",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.2:3b",
      "TimeoutSeconds": 60
    }
  },
  "Stream": {
    "MaxConcurrentSSE": 50
  },
  "Retention": {
    "MaxActiveIncidents": 0,
    "MaxTotalIncidents": 0,
    "MaxLogEntries": 0,
    "AutoResolveIdleMinutes": 0
  },
  "Simulation": {
    "LogsPerSecond": 5,
    "LogIntervalMs": 600,
    "SpikeDelaySeconds": 10,
    "SpikeDurationSeconds": 60,
    "SpikeMultiplier": 3,
    "DeploymentEventInjection": true,
    "DefaultSeed": 42
  }
}
