{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "App": {
    "ReadOnlyMode": true
  },
  "AI": {
    "Provider": "Mock",
    "AllowProviderSwitch": false
  },
  "Retention": {
    "MaxActiveIncidents": 10,
    "MaxTotalIncidents": 100,
    "MaxLogEntries": 5000,
    "AutoResolveIdleMinutes": 15
  },
  "RateLimit": {
    "GeneralPerSecond": 60,
    "MutationPerMinute": 10
  }
}
